---
import { MOOD_SCALE, moodBySlug } from "@/lib/moodScale"
import { MONTH_NAMES, WEEKDAY_LONG, formatSpoken } from "@/lib/calendar"
import { useTranslations } from "@/i18n"

/**
 * The app's single-day view, from components/CalendarViews/DayView.tsx.
 *
 * Enlarged cell on the left with the day number overlaid (tone taken from the
 * AM mood's textTone), the Split AM/PM switch, one score picker per half, the
 * admission switch, then the notes column. Save and Clear are grouped at the
 * bottom left rather than pushed to opposite edges — they act on the same
 * thing, so they belong together.
 *
 * Score pickers are *circles*. Calendar cells are squircles. Those are two
 * different components in the app and the shapes aren't interchangeable.
 *
 * AM and PM stay untranslated, by brand direction.
 *
 * ── Why the date is live ──────────────────────────────────────────────────
 * The app opens this view on today, so the illustration should too. A fixed
 * date reads as a screenshot from whenever the page was written; the reader's
 * own date reads as the thing they'd see if they opened it.
 *
 * Rendered at build time and corrected on the client, in that order. The
 * build value is right for whoever looks at it that day and keeps the static
 * output complete for anyone with JavaScript off; the client pass is what
 * stops it going stale a week later.
 *
 * ── Why this doesn't contradict the calendars ─────────────────────────────
 * What's shown is an *unsaved draft*: two halves picked, Save day not yet
 * pressed. DayView holds a draft in exactly this state. So a live date can't
 * disagree with the saved history the month grids are drawn from, because
 * nothing here has been saved. Don't "fix" this by wiring it to the fixture —
 * that reintroduces the clash on any day the fixture happens to cover.
 */

// Illustrative draft. A day that started okay and fell apart is the case the
// whole section exists to explain, so the two halves must differ.
const am = moodBySlug("okay")
const pm = moodBySlug("bad")

const today = new Date()
const buildDate = new Date(
  Date.UTC(today.getUTCFullYear(), today.getUTCMonth(), today.getUTCDate())
)

const t = useTranslations()

const weekday = WEEKDAY_LONG[buildDate.getUTCDay()]
const spoken = formatSpoken(buildDate)

// Template the client fills in, so the accessible name tracks the visible
// date instead of drifting away from it.
const labelTemplate = `{date}, ${am.label} in the morning, ${pm.label} in the evening, draft not yet saved`

const pickers = [
  { label: t.dayView.am, mood: am },
  { label: t.dayView.pm, mood: pm },
]
---

<div class="rounded-[var(--radius)] border border-border-strong bg-surface p-5 sm:p-7">
  <div class="mb-5 flex items-baseline justify-between gap-4 border-b border-border pb-3.5">
    <span class="font-display text-[17px] font-semibold" data-live-date>
      {weekday}{" "}{spoken}
    </span>
    <span class="font-mono text-[10px] tracking-[0.13em] text-muted-strong uppercase">
      {t.dayView.scaleLabel}
    </span>
  </div>

  <div class="grid grid-cols-1 items-start gap-6 sm:grid-cols-[minmax(190px,32%)_1fr] sm:gap-8">
    <div>
      <div
        class="relative mb-3.5 aspect-square w-full max-w-[320px] rounded-[24%] border border-border"
        style={`background:linear-gradient(135deg,hsl(var(${am.cssVar})) 50%,hsl(var(${pm.cssVar})) 50%)`}
        role="img"
        aria-label={labelTemplate.replace("{date}", spoken)}
        data-live-label
        data-label-template={labelTemplate}
      >
        <b
          class:list={[
            "absolute top-0 left-0 pt-6 pl-7 font-mono text-2xl leading-none font-semibold sm:text-3xl md:text-4xl",
            am.textTone === "light" ? "text-white" : "text-neutral-900",
          ]}
          data-live-day>{buildDate.getUTCDate()}</b
        >
      </div>

      <p class="mb-3 flex items-center gap-3 text-[13px]">
        <span
          class="relative h-5 w-[34px] flex-none rounded-full bg-foreground after:absolute after:top-0.5 after:left-0.5 after:size-4 after:translate-x-3.5 after:rounded-full after:bg-surface after:content-['']"
          aria-hidden="true"></span>
        {t.dayView.split}
      </p>

      {
        pickers.map((picker, i) => (
          <div class:list={[i > 0 && "mt-3"]}>
            <p class="mb-1 text-xs text-muted-strong">{picker.label}</p>
            <div
              class="grid grid-cols-7 gap-2"
              role="img"
              aria-label={`Seven mood levels. ${picker.mood.label} selected for ${picker.label}.`}
            >
              {MOOD_SCALE.map((mood) => (
                <span
                  class:list={[
                    "block aspect-square rounded-full border-2",
                    mood.bg,
                    mood.score === picker.mood.score ? "border-foreground" : "border-transparent",
                  ]}
                  aria-hidden="true"
                />
              ))}
            </div>
            <p class="mt-2 min-h-4 text-xs text-muted-strong">{picker.mood.label}</p>
          </div>
        ))
      }

      <p class="mt-3 flex items-center gap-3 text-[13px]">
        <span
          class="relative h-5 w-[34px] flex-none rounded-full bg-border-strong after:absolute after:top-0.5 after:left-0.5 after:size-4 after:rounded-full after:bg-surface after:content-['']"
          aria-hidden="true"></span>
        {t.dayView.admission}
      </p>
    </div>

    <div class="flex h-full flex-col">
      <p class="mb-2 font-display text-[15px] font-semibold">{t.dayView.notes}</p>
      <p
        class="min-h-[190px] flex-1 rounded-md border border-border bg-background p-3 text-sm leading-[1.55] sm:min-h-[230px]"
      >
        {t.dayView.sampleNote}
      </p>
      <p class="mt-3 flex items-center gap-3 text-[13px]">
        <span
          class="relative h-5 w-[34px] flex-none rounded-full bg-border-strong after:absolute after:top-0.5 after:left-0.5 after:size-4 after:rounded-full after:bg-surface after:content-['']"
          aria-hidden="true"></span>
        {t.dayView.keepPrivate}
      </p>
    </div>
  </div>

  <p class="mt-6 flex gap-2">
    <span
      class="rounded-lg border-[1.5px] border-transparent bg-accent px-4 py-[9px] text-[13px] font-semibold text-on-accent"
      >{t.dayView.save}</span
    >
    <span
      class="rounded-lg border-[1.5px] border-danger/45 px-4 py-[9px] text-[13px] font-semibold text-danger"
      >{t.dayView.clear}</span
    >
  </p>
</div>

<script is:inline define:vars={{ MONTH_NAMES, WEEKDAY_LONG }}>
  // Corrects the build-time date to the reader's own. Inline and synchronous
  // so it lands before paint — a date that visibly changes after load would
  // be worse than one that's a few days out.
  ;(() => {
    const now = new Date()
    const day = now.getDate()
    const spoken = `${day} ${MONTH_NAMES[now.getMonth()]} ${now.getFullYear()}`

    const dateEl = document.querySelector("[data-live-date]")
    if (dateEl) dateEl.textContent = `${WEEKDAY_LONG[now.getDay()]} ${spoken}`

    const dayEl = document.querySelector("[data-live-day]")
    if (dayEl) dayEl.textContent = String(day)

    const cellEl = document.querySelector("[data-live-label]")
    const template = cellEl?.getAttribute("data-label-template")
    if (cellEl && template) cellEl.setAttribute("aria-label", template.replace("{date}", spoken))
  })()
</script>
