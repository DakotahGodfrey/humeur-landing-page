---
import { MOOD_SCALE } from "@/lib/moodScale"
import { useTranslations } from "@/i18n"

/**
 * The mood scale legend. Circular swatches, matching the app.
 *
 * The swatches are aria-hidden and the label beside each one carries the
 * meaning, so this reads correctly with colour vision, without it, and with
 * no vision at all.
 */

interface Props {
  showAdmission?: boolean
  class?: string
}

const { showAdmission = true, class: className = "" } = Astro.props
const t = useTranslations()
---

<ul class:list={["flex flex-wrap gap-x-4.5 gap-y-2 text-xs text-muted-strong", className]}>
  {
    MOOD_SCALE.map((mood) => (
      <li class="flex items-center gap-1.5">
        <i
          class:list={[
            "block size-[11px] flex-none rounded-full shadow-[inset_0_0_0_1px_hsl(var(--foreground)/0.22)]",
            mood.bg,
          ]}
          aria-hidden="true"
        />
        {mood.label}
      </li>
    ))
  }
  <li class="flex items-center gap-1.5">
    <i
      class="block size-[11px] flex-none rounded-full bg-surface shadow-[inset_0_0_0_1px_hsl(var(--border-strong))]"
      aria-hidden="true"></i>
    {t.legend.nothing}
  </li>
  {
    showAdmission && (
      <li class="flex items-center gap-1.5">
        <i
          class="relative block size-[11px] flex-none overflow-hidden rounded-[22%] bg-admission-plate shadow-[inset_0_0_0_1px_hsl(var(--foreground)/0.22)] after:absolute after:inset-[1.5px] after:rounded-[15%] after:bg-admission-mark after:content-['']"
          aria-hidden="true"
        />
        {t.legend.admission}
      </li>
    )
  }
</ul>
