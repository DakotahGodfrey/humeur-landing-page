---
import { MOOD_SCALE } from "@/lib/moodScale"
import {
  MONTH_NAMES,
  WEEKDAYS_PRINT,
  describeMonth,
  formatLong,
  monthCells,
  rangeStats,
} from "@/lib/calendar"
import { isSplit } from "@/lib/history"
import { DEMO_RANGE } from "@/lib/site"
import { useTranslations } from "@/i18n"

/**
 * The printed provider summary, reproduced from a real export.pdf.
 *
 * Both pages of the PDF are composited into one image here — page one is the
 * grids and the scale, page two is the figures and the admissions list. The
 * caption on the section says so.
 *
 * Paper does not invert with the theme. This depicts something that comes out
 * of a printer, so it stays on paper colours in both modes.
 *
 * Print differs from screen in two places, and both are deliberate:
 *   - an admission is `**` here, not the two-tone glyph
 *   - a day with no entry is a plain empty cell, not a dashed one
 */

const t = useTranslations()
const { from, to, months } = DEMO_RANGE
const stats = rangeStats(from, to)
---

<article
  class="rounded-sm border border-paper-rule bg-paper p-5 text-paper-ink shadow-[0_2px_0_rgba(234,218,189,0.5),0_30px_60px_-40px_rgba(45,37,31,0.45)] sm:p-8"
  aria-label="Example of the printed provider summary"
>
  <div
    class="mb-4 flex justify-between border-b border-paper-rule pb-3 font-serif text-[9px] text-paper-muted"
    aria-hidden="true"
  >
    <span>8/8/26, 9:03 AM</span>
    <span>Humeur</span>
    <span>humeur.dev/export</span>
  </div>

  <p class="font-display text-lg font-semibold tracking-[-0.01em]">{t.sheet.title}</p>
  {/* One expression rather than four: Astro collapses the whitespace between
      adjacent expressions on separate lines, which ran this together as
      "CoveringFri 1 May 2026toFri 31 Jul 2026". */}
  <p class="mt-1.5 text-xs">
    {`${t.sheet.covering} ${formatLong(from)} ${t.sheet.to} ${formatLong(to)}`}
  </p>
  <p class="mt-0.5 text-[11px] text-paper-muted">{t.sheet.generated}</p>

  <div class="mt-6 grid grid-cols-2 gap-4.5 sm:grid-cols-3 sm:gap-5">
    {
      months.map(({ year, month }) => (
        <div>
          <p class="mb-1.5 text-center font-display text-xs font-semibold">
            {MONTH_NAMES[month - 1]} {year}
          </p>
          <div
            class="mb-0.5 grid grid-cols-7 gap-0.5 text-center text-[7px] font-bold tracking-[0.04em] text-paper-muted"
            aria-hidden="true"
          >
            {WEEKDAYS_PRINT.map((d) => (
              <span>{d}</span>
            ))}
          </div>
          <div
            class="grid grid-cols-7 gap-x-0.5 gap-y-px"
            role="img"
            aria-label={describeMonth(year, month)}
          >
            {monthCells(year, month).map((cell) => {
              const e = cell.entry
              const style = e?.am
                ? `background:${
                    isSplit(e)
                      ? `linear-gradient(135deg,hsl(var(${e.am.cssVar})) 50%,hsl(var(${e.pm!.cssVar})) 50%)`
                      : `hsl(var(${e.am.cssVar}))`
                  };box-shadow:inset 0 0 0 .8px rgba(45,37,31,.16)`
                : cell.date
                  ? "background:#FFFCF5;box-shadow:inset 0 0 0 .8px #EADABD"
                  : undefined
              return (
                <span class="block">
                  <span class="block aspect-square rounded-[24%]" style={style} />
                  <span class="relative block text-center font-mono text-[7px] leading-[1.6] font-semibold text-paper-muted">
                    {e?.admission && (
                      <span
                        class="absolute -top-2 left-1/2 -translate-x-1/2 font-mono text-[8px] font-semibold text-paper-ink"
                        aria-hidden="true"
                      >
                        **
                      </span>
                    )}
                    {cell.dayOfMonth}
                  </span>
                </span>
              )
            })}
          </div>
        </div>
      ))
    }
  </div>

  <div class="mt-6 border-t border-paper-rule pt-3.5">
    <p class="mb-2 font-display text-xs font-semibold">{t.sheet.scale}</p>
    <ul class="flex flex-wrap gap-x-3 gap-y-1.5 text-[10px]">
      {
        MOOD_SCALE.map((mood) => (
          <li class="flex items-center gap-1.5">
            <i
              class:list={[
                "block size-[9px] flex-none rounded-[2px] shadow-[inset_0_0_0_.8px_rgba(45,37,31,.2)]",
                mood.bg,
              ]}
              aria-hidden="true"
            />
            {mood.label}
          </li>
        ))
      }
      <li class="flex items-center gap-1.5">
        <i
          class="block size-[9px] flex-none rounded-[2px] bg-paper shadow-[inset_0_0_0_.8px_#EADABD]"
          aria-hidden="true"></i>
        {t.legend.nothing}
      </li>
    </ul>
    <p class="mt-2.5 flex flex-wrap gap-x-5 gap-y-1.5 text-[10px] text-paper-muted">
      <span class="flex items-center gap-1.5"
        ><b class="font-mono font-semibold">*</b>{t.sheet.keyAdmission}</span
      >
      <span class="flex items-center gap-1.5">
        <i
          class="block size-[9px] flex-none rounded-[2px] shadow-[inset_0_0_0_.8px_rgba(45,37,31,.2)]"
          style="background:linear-gradient(135deg,hsl(var(--mood-okay)) 50%,hsl(var(--mood-bad)) 50%)"
          aria-hidden="true"></i>
        {t.sheet.keySplit}
      </span>
    </p>
  </div>

  <div class="mt-6 border-t border-paper-rule pt-4">
    <p class="mb-3 font-display text-xs font-semibold">{t.sheet.summary}</p>
    <div class="grid grid-cols-2 gap-3 min-[30rem]:grid-cols-4">
      <div>
        <p class="text-[10px] text-paper-muted">{t.sheet.daysInPeriod}</p>
        <p class="mt-0.5 font-mono text-[13px]">{stats.total}</p>
      </div>
      <div>
        <p class="text-[10px] text-paper-muted">{t.sheet.daysLogged}</p>
        <p class="mt-0.5 font-mono text-[13px]">{stats.logged} ({stats.percentLogged}%)</p>
      </div>
      <div>
        <p class="text-[10px] text-paper-muted">{t.sheet.notLogged}</p>
        <p class="mt-0.5 font-mono text-[13px]">{stats.notLogged}</p>
      </div>
      <div>
        <p class="text-[10px] text-paper-muted">{t.sheet.averageMood}</p>
        <p class="mt-0.5 font-mono text-[13px]">{stats.average}</p>
      </div>
    </div>

    <p class="mt-3.5 text-[11px]">
      {t.sheet.lowest}: {stats.lowest}. {t.sheet.highest}: {stats.highest}.
    </p>

    <div class="mt-3.5">
      <p class="mb-1.5 font-display text-[11px] font-semibold">
        {t.sheet.mix} ({stats.entries} {t.sheet.entries})
      </p>
      <ul class="flex flex-wrap gap-x-3 gap-y-1.5 text-[10px]">
        {
          stats.mix.map((m) => (
            <li class="flex items-center gap-1.5">
              <i
                class="block size-2 flex-none rounded-[2px] shadow-[inset_0_0_0_.8px_rgba(45,37,31,.2)]"
                style={`background:hsl(var(${m.cssVar}))`}
                aria-hidden="true"
              />
              {m.label} <b class="font-mono font-normal">{m.count}</b>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="mt-3.5 text-[11px]">
      <p class="mb-0.5 font-display text-[11px] font-semibold">{t.sheet.admissions}</p>
      {
        stats.admissions.map((run) => (
          <p class="font-sans">
            {formatLong(run.from)}
            {run.days > 1 ? ` – ${formatLong(run.to)}` : ""}
          </p>
        ))
      }
    </div>
  </div>

  <p class="mt-4.5 border-t border-paper-rule pt-3 text-[10px] text-paper-muted">
    {t.sheet.fine}
  </p>
</article>
