---
import BaseLayout from "@/layouts/BaseLayout.astro"
import PostCard from "@/components/blog/PostCard.astro"
import TagList from "@/components/blog/TagList.astro"
import { publishedPosts, tagsInUse } from "@/lib/posts"
import { resolveLocale, useTranslations } from "@/i18n"

/**
 * The notes index, for whichever locale the URL says.
 *
 * Held here rather than in the route files so `/blog/` and `/[locale]/blog/`
 * cannot drift into two different pages. Both routes are three lines long and
 * exist only to declare which paths get built.
 */

const locale = resolveLocale(Astro.currentLocale)
const t = useTranslations(locale)
const posts = await publishedPosts(locale)
const tags = await tagsInUse(locale)
---

<BaseLayout title={t.blog.title} description={t.blog.description}>
  <div class="mx-auto w-full max-w-[62rem] px-4 py-12 sm:px-8 sm:py-16">
    <header class="border-b border-border-strong pb-8">
      <p class="mb-4 font-mono text-[11px] tracking-[0.14em] text-muted-foreground uppercase">
        {t.blog.eyebrow}
      </p>
      <h1
        class="font-display text-[clamp(2rem,6vw,3rem)] leading-[1.06] font-medium tracking-[-0.028em] text-balance"
      >
        {t.blog.heading}
      </h1>
      <p class="mt-4 max-w-[38rem] text-[17px] text-muted-foreground">{t.blog.lead}</p>
      {tags.length > 0 && <TagList tags={tags} class="mt-6" />}
    </header>

    {
      posts.length === 0 ? (
        <p class="py-14 text-muted-foreground">{t.blog.empty}</p>
      ) : (
        <div>
          {posts.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      )
    }
  </div>
</BaseLayout>
