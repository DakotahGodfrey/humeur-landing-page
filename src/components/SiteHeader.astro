---
import Button from "./Button.astro"
import ThemeToggle from "./ThemeToggle.astro"
import { useTranslations } from "@/i18n"
import { links } from "@/lib/site"

const t = useTranslations()
---

<header class="sticky top-0 z-20 border-b border-border-strong bg-background">
  <div class="mx-auto flex min-h-14 w-full max-w-[78rem] items-center gap-4 px-4 sm:px-8">
    <a
      href={links.home}
      class="flex items-center gap-2.5 font-display text-lg font-semibold tracking-[-0.01em] no-underline"
    >
      <span
        class="size-4 flex-none rounded-[24%] shadow-[inset_0_0_0_1px_hsl(var(--foreground)/0.25)]"
        style="background:linear-gradient(135deg,hsl(var(--mood-okay)) 50%,hsl(var(--mood-bad)) 50%)"
        aria-hidden="true"></span>
      Humeur
    </a>

    <nav
      class="ml-10 hidden gap-5.5 font-mono text-[11px] tracking-[0.1em] uppercase lg:flex"
      aria-label={t.nav.primary}
    >
      {
        t.nav.items.map((item) => (
          <a href={item.href} class="text-muted-strong no-underline hover:text-foreground">
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto flex items-center gap-2">
      <ThemeToggle />
      <Button href={links.app} size="sm">{t.nav.start}</Button>
    </div>
  </div>
</header>
