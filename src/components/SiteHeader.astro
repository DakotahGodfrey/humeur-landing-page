---
import Button from "./Button.astro"
import ThemeToggle from "./ThemeToggle.astro"
import { useTranslations } from "@/i18n"
import { links } from "@/lib/site"

const t = useTranslations()
---

<header class="sticky top-0 z-20 border-b border-border-strong bg-background">
  <div class="mx-auto flex min-h-14 w-full max-w-[78rem] items-center gap-4 px-4 sm:px-8">
    <a
      href={links.home}
      class="flex items-center gap-2.5 font-display text-lg font-semibold tracking-[-0.01em] no-underline"
    >
      {/* The brand mark: a split day, Great in the morning and Bad in the
          evening, drawn with the same 135° construction the calendar uses.

          Great + Bad, not Okay + Bad — this is what app/logo-1024.png is, and
          the header, the favicon and the app icon are meant to be one mark.
          The radius is ~15% to match that file too; it was 24%, which read as
          a noticeably rounder object beside the real icon.

          No inset hairline. The logo has no border, and on the light sheet
          the yellow half was the only reason one seemed necessary. */}
      <span
        class="size-4 flex-none rounded-[15%]"
        style="background:linear-gradient(135deg,hsl(var(--mood-great)) 50%,hsl(var(--mood-bad)) 50%)"
        aria-hidden="true"></span>
      Humeur
    </a>

    <nav
      class="ml-10 hidden gap-5.5 font-mono text-[11px] tracking-[0.1em] uppercase lg:flex"
      aria-label={t.nav.primary}
    >
      {
        t.nav.items.map((item) => (
          <a href={item.href} class="text-muted-foreground no-underline hover:text-foreground">
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto flex items-center gap-2">
      <ThemeToggle />
      <Button href={links.app} size="sm">{t.nav.start}</Button>
    </div>
  </div>
</header>
