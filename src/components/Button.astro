---
interface Props {
  href: string
  variant?: "primary" | "ghost"
  size?: "sm" | "md" | "lg"
  class?: string
}

const { href, variant = "primary", size = "md", class: className = "" } = Astro.props

const base =
  "inline-flex cursor-pointer items-center justify-center gap-2 rounded-lg border-[1.5px] font-semibold no-underline transition-colors"

const variants = {
  primary: "border-accent bg-accent text-on-accent hover:bg-accent/85",
  ghost: "border-border-strong bg-transparent text-foreground hover:bg-accent-surface",
} as const

const sizes = {
  sm: "px-3.5 py-[7px] text-[13px]",
  md: "px-5 py-[13px] text-[15px]",
  lg: "px-7 py-[15px] text-base",
} as const
---

<a href={href} class:list={[base, variants[variant], sizes[size], className]}>
  <slot />
</a>
