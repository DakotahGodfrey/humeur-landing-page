---
import Button from "../Button.astro"
import { links } from "@/lib/site"
import { useTranslations } from "@/i18n"

const t = useTranslations()
---

<section class="py-16 text-center">
  <div class="mx-auto w-full max-w-[78rem] px-4 sm:px-8">
    <h2
      class="mb-4 font-display text-[clamp(1.625rem,4.6vw,2.4375rem)] leading-[1.1] font-medium tracking-[-0.022em] text-balance"
    >
      {t.finalCta.heading}
    </h2>
    <p class="mb-6 text-muted-foreground">{t.finalCta.sub}</p>
    <Button href={links.app} size="lg">{t.finalCta.cta}</Button>
  </div>
</section>
