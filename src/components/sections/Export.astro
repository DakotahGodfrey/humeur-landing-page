---
import Section from "../Section.astro"
import ExportSheet from "../ExportSheet.astro"
import { useTranslations } from "@/i18n"

/**
 * Export is the differentiator, so it leads with the artifact rather than the
 * word "export". It also never mentions a plan restriction, because there
 * isn't one — someone's mood history is a medical record about them, and it
 * has to be as easy to leave with as it was to build.
 */

const t = useTranslations()
---

<Section id="export" index="05" label={t.exportSection.section}>
  <div class="grid gap-7 lg:grid-cols-[1fr_1.02fr] lg:items-start lg:gap-10">
    <div>
      <h2
        class="mb-4 font-display text-[clamp(1.625rem,4.6vw,2.4375rem)] leading-[1.1] font-medium tracking-[-0.022em] text-balance"
      >
        {t.exportSection.heading}
      </h2>
      <p class="max-w-[40rem] text-[17px] text-muted-foreground">{t.exportSection.lead}</p>

      <p class="mt-4.5 max-w-[40rem] text-muted-foreground">{t.exportSection.notes}</p>

      <p class="mt-4.5 text-[17px]">
        <strong class="font-semibold">{t.exportSection.free}</strong>
      </p>

      <div class="mt-5 flex flex-wrap gap-2">
        {
          t.exportSection.files.map((file) => (
            <span class="inline-flex items-center gap-1.5 rounded-md border border-border-strong px-2.5 py-[7px] font-mono text-[11px] text-muted-foreground">
              <b class="font-medium text-foreground">{file}</b>
            </span>
          ))
        }
      </div>
      <p class="mt-3.5 font-mono text-[10px] leading-[1.6] tracking-[0.05em] text-muted-foreground">
        {t.exportSection.filesNote}
      </p>

      <p
        class="mt-7 max-w-[36rem] border-l-[2.5px] border-accent pl-4 font-display text-[clamp(1.0625rem,2.6vw,1.375rem)] leading-[1.45]"
      >
        {t.exportSection.pull}
      </p>
    </div>

    <div>
      <ExportSheet />
      <p class="mt-3.5 font-mono text-[10px] leading-[1.6] tracking-[0.05em] text-muted-foreground">
        {t.exportSection.caption}
      </p>
    </div>
  </div>
</Section>
