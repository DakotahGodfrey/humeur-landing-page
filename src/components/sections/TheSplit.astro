---
import Section from "../Section.astro"
import Shot from "../Shot.astro"
import { shots } from "@/lib/shots"
import { useTranslations } from "@/i18n"

/**
 * The wedge. One sentence about what other trackers get wrong, one about what
 * this does instead, then the screen — the split is easier to see than to
 * read about, and this audience does not need a paragraph explaining that a
 * bad evening is different from a bad day.
 *
 * The capture is the real day view, which is also the first place on the page
 * the structured fields appear. The section after this one is about those;
 * this one stays on the split and lets them sit in the background.
 */

const t = useTranslations()
---

<Section id="split" index="02" label={t.split.section}>
  <h2
    class="mb-4 font-display text-[clamp(1.625rem,4.6vw,2.4375rem)] leading-[1.1] font-medium tracking-[-0.022em] text-balance"
  >
    {t.split.heading}
  </h2>
  <p class="max-w-[40rem] text-[17px] text-muted-foreground">{t.split.lead}</p>

  <Shot
    class="mt-8"
    light={shots.day.light}
    mobile={shots.mobileDay.light}
    alt={t.shots.day}
    label={t.split.panelLabel}
    meta={t.split.panelMeta}
  >
    {t.split.caption}
  </Shot>
</Section>
