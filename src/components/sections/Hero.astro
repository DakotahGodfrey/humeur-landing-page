---
import Button from "../Button.astro"
import Shot from "../Shot.astro"
import { shots } from "@/lib/shots"
import { links } from "@/lib/site"
import { useTranslations } from "@/i18n"

/**
 * The headline argues that a pattern needs time, so the hero shows the view
 * that is nothing but time — a whole year on one screen.
 *
 * This used to be three hand-drawn month grids with a computed statistics
 * readout beside them. The readout has gone with them: the figures were
 * derived from a demo history in this repo, and a set of invented numbers
 * styled as instrumentation is a worse thing to put at the top of the page
 * than no numbers at all. The capture carries its own, and they're real.
 */

const t = useTranslations()
---

<section class="py-11 lg:py-14">
  <div class="mx-auto w-full max-w-[78rem] px-4 sm:px-8">
    <div class="max-w-[46rem]">
      <p class="mb-4 font-mono text-[11px] tracking-[0.14em] text-muted-foreground uppercase">
        {t.hero.eyebrow}
      </p>
      <h1
        class="mb-5 font-display text-[clamp(2.125rem,7.4vw,3.75rem)] leading-[1.04] font-medium tracking-[-0.03em] text-balance"
      >
        {t.hero.headline}
      </h1>
      <p class="mb-7 max-w-[34rem] text-[17px] leading-[1.6] text-muted-foreground">
        {t.hero.sub}
      </p>
      <div class="mb-3.5 flex flex-wrap gap-2.5">
        <Button href={links.app} size="lg">{t.hero.primaryCta}</Button>
        <Button href="/#how" variant="ghost" size="lg">{t.hero.secondaryCta}</Button>
      </div>
      <p class="max-w-[26rem] text-[13px] text-muted-foreground">{t.hero.note}</p>
    </div>

    {/* The one shot on the page that loads eagerly. */}
    <Shot
      class="mt-10 lg:mt-12"
      light={shots.year.light}
      dark={shots.year.dark}
      mobile={shots.mobileYear.light}
      alt={t.shots.year}
      label={t.hero.panelLabel}
      meta={t.hero.panelMeta}
      priority
    >
      {t.hero.caption}
    </Shot>
  </div>
</section>
