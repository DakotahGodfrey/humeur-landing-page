---
import Section from "../Section.astro"
import Shot from "../Shot.astro"
import { shots } from "@/lib/shots"
import { useTranslations } from "@/i18n"

/**
 * Calm, short, never alarming. It reassures by existing, not by shouting.
 *
 * This is the only place --crisis is allowed. It is not an "urgent" accent
 * for marketing moments — if it appears anywhere else on the page, the one
 * surface where red actually means something loses its meaning.
 *
 * Nothing here is behind a sign-up, a tier, or a CTA. It sits above pricing
 * on the page for the same reason.
 */

const t = useTranslations()
---

<Section id="crisis" index="10" label={t.crisis.section}>
  <div class="rounded-[10px] border border-crisis-border bg-crisis-surface p-6 sm:p-8">
    <h2
      class="mb-4 font-display text-[clamp(1.375rem,3.6vw,1.875rem)] leading-[1.1] font-medium tracking-[-0.022em] text-crisis text-balance"
    >
      {t.crisis.heading}
    </h2>
    <p class="max-w-[42rem] leading-[1.65]">{t.crisis.body}</p>
    <p class="mt-3 max-w-[42rem] leading-[1.65]">{t.crisis.body2}</p>

    <ul class="mt-4.5 flex flex-wrap gap-1.5">
      {
        t.crisis.regions.map((region) => (
          <li class="rounded-md border border-crisis-border px-2 py-[5px] font-mono text-[10px] tracking-[0.08em] uppercase">
            {region}
          </li>
        ))
      }
    </ul>
  </div>

  {/* Outside the crisis-tinted card, in the page's ordinary frame. The tint
      marks the surface where red means something; the screenshot is a
      screenshot like every other one on the page and doesn't need it. */}
  <Shot
    class="mt-6"
    light={shots.crisis.light}
    alt={t.shots.crisis}
    label={t.crisis.panelLabel}
    meta={t.crisis.panelMeta}
  >
    {t.crisis.caption}
  </Shot>
</Section>
