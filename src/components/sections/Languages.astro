---
import Section from "../Section.astro"
import { useTranslations } from "@/i18n"

const t = useTranslations()
---

<Section id="languages" index="08" label={t.languages.section}>
  <h2
    class="mb-4 font-display text-[clamp(1.625rem,4.6vw,2.4375rem)] leading-[1.1] font-medium tracking-[-0.022em] text-balance"
  >
    {t.languages.heading}
  </h2>
  <p class="max-w-[40rem] text-[17px] text-muted-foreground">{t.languages.lead}</p>

  <ul class="mt-7 grid gap-4 min-[40rem]:grid-cols-4">
    {
      t.languages.list.map((lang) => (
        <li class="rounded-[10px] border border-border-strong bg-surface p-4">
          <p class="font-display text-[17px] font-medium">{lang.name}</p>
          <p class="mt-1 font-mono text-[10px] tracking-[0.13em] text-muted-foreground uppercase">
            {lang.code}
          </p>
        </li>
      ))
    }
  </ul>
</Section>
