---
import Section from "../Section.astro"
import Shot from "../Shot.astro"
import { shots } from "@/lib/shots"
import { resolveLocale, useTranslations } from "@/i18n"

/**
 * Completes the loop: track → see the pattern → find someone → hand them the
 * summary. The last section before crisis and pricing that is about the
 * product doing something for you rather than about what it won't do.
 *
 * This was the last hand-built mockup on the page — a Panel with filter chips
 * and result rows assembled from the dictionary. It had drifted: six provider
 * types where the app has eight, and a set of invented clinic names. The
 * capture replaces all of it, and the chips and results that only existed to
 * feed that mockup are gone from the dictionary with it.
 *
 * The only view captured light, dark *and* phone, so it's the one place all
 * three of Shot's axes are exercised at once.
 */

const t = useTranslations(resolveLocale(Astro.currentLocale))
---

<Section id="providers" index="07" label={t.providers.section}>
  <h2
    class="mb-4 font-display text-[clamp(1.625rem,4.6vw,2.4375rem)] leading-[1.1] font-medium tracking-[-0.022em] text-balance"
  >
    {t.providers.heading}
  </h2>
  <p class="max-w-[42rem] text-[17px] text-muted-foreground">{t.providers.lead}</p>

  <Shot
    class="mt-8"
    light={shots.provider.light}
    dark={shots.provider.dark}
    mobile={shots.mobileProvider.light}
    alt={t.shots.provider}
    label={t.providers.panelLabel}
    meta={t.providers.panelMeta}
  >
    {t.providers.caption}
  </Shot>

  <p class="mt-6 max-w-[40rem] text-[17px] text-muted-foreground">{t.providers.close}</p>
</Section>
