---
import TagPage from "@/components/blog/TagPage.astro"
import { postsByTag, tagsInUse } from "@/lib/posts"
import { defaultLocale } from "@/i18n"
import type { GetStaticPaths } from "astro"

/**
 * Only tags that have posts get a route. An empty tag page reads as a broken
 * site, and linking to one from a post is worse than not linking at all.
 */
export const getStaticPaths = (async () => {
  const tags = await tagsInUse(defaultLocale)
  return Promise.all(
    tags.map(async (tag) => ({
      params: { tag },
      props: { tag, posts: await postsByTag(tag, defaultLocale) },
    })),
  )
}) satisfies GetStaticPaths

const { tag, posts } = Astro.props
---

<TagPage tag={tag} posts={posts} />
