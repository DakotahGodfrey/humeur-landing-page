---
import Section from "@/components/Section.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

// src/pages/404.astro
---

<BaseLayout>
  <Section id="404" label="404 Not Found"  index=""  class="py-11 lg:py-16 ">
  <div class="flex flex-col items-center justify-center w-full  border border-border py-16 rounded-2xl bg-surface ">
    <h1 class="mb-4 font-display text-[clamp(1.625rem,4.6vw,2.4375rem)] leading-[1.1] font-medium tracking-[-0.022em] text-balance">404 - Page Not Found</h1>
    <p class="leading-[1.6] text-muted-foreground">Sorry, the page you are looking for doesn't exist.</p>
    <a href="/" class="font-mono mt-4 text-accent-text underline decoration-2 underline-offset-3">Go back to homepage</a>
  </div>
</Section >
</BaseLayout>
