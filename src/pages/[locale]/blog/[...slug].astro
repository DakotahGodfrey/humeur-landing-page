---
import { render } from "astro:content"
import PostLayout from "@/layouts/PostLayout.astro"
import { publishedPosts } from "@/lib/posts"
import { localeSegment, prefixedLocales } from "@/i18n"
import type { GetStaticPaths } from "astro"

/**
 * A post in a prefixed locale.
 *
 * Every slug gets a route in every locale, because `publishedPosts` returns
 * the en-CA original flagged `fallback` wherever a translation is missing. A
 * French reader following a link to an untranslated piece gets the English
 * text with a line saying so, rather than a 404 — which is the difference
 * between a blog that is partly translated and one that looks broken.
 */
export const getStaticPaths = (async () => {
  const paths = await Promise.all(
    prefixedLocales.map(async (locale) => {
      const posts = await publishedPosts(locale)
      return posts.map((post) => ({
        params: { locale: localeSegment(locale), slug: post.data.slug },
        props: { post },
      }))
    }),
  )
  return paths.flat()
}) satisfies GetStaticPaths

const { post } = Astro.props
const { Content } = await render(post)
---

<PostLayout post={post}>
  <Content />
</PostLayout>
