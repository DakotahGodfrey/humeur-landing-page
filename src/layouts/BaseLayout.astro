---
import { Font } from "astro:assets"
import SiteHeader from "@/components/SiteHeader.astro"
import SiteFooter from "@/components/SiteFooter.astro"
import { useTranslations, defaultLocale, type Locale } from "@/i18n"
import "@/styles/global.css"

interface Props {
  locale?: Locale
  title?: string
  description?: string
}

const { locale = defaultLocale, title, description } = Astro.props
const t = useTranslations(locale)

const pageTitle = title ?? t.meta.title
const pageDescription = description ?? t.meta.description
const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://humeur.dev")

/* The share card. It lives in public/ rather than src/assets on purpose:
   crawlers need one stable, unhashed, absolute URL, and the build's image
   pipeline would give it a content hash and a webp sibling that Slack and
   iMessage don't reliably render. Absolute because every scraper resolves
   og:image against nothing. Recapture it with the rest of the promo set. */
const ogImage = new URL("/og.png", Astro.site ?? "https://humeur.dev")
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    <meta name="color-scheme" content="light dark" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="2400" />
    <meta property="og:image:height" content="1350" />
    <meta property="og:image:alt" content={t.meta.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    {/* .ico first, SVG second: a browser that understands the SVG takes it
        regardless of order, and one that doesn't never reads past the .ico.
        Both are the split-day mark from app/logo-1024.png — the .ico is
        downscaled from that file directly, the SVG traces its outline. */}
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {/* iOS home-screen bookmarks ignore both of the above. */}
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {/* Paints the browser chrome to match --background in each theme, so the
        address bar doesn't sit as a white bar above the warm sheet. */}
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#F8F2E8" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#171A26" />

    {/* Self-hosted and preloaded, so there's no third-party request before
        first paint and no swap flash on the display face. */}
    <Font cssVariable="--font-humeur-ui" preload />
    <Font cssVariable="--font-humeur-display" preload />
    <Font cssVariable="--font-humeur-mono" />
  </head>

  <body>
    <a
      href="#main"
      class="absolute top-0 -left-[9999px] z-50 rounded-br-[var(--radius)] border-2 border-foreground bg-surface px-5 py-3 font-semibold text-foreground focus:left-0"
    >
      {t.nav.skip}
    </a>

    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
