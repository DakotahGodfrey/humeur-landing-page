---
import BaseLayout from "./BaseLayout.astro"
import TagList from "@/components/blog/TagList.astro"
import Button from "@/components/Button.astro"
import { formatPostDate, isoDate, type Post } from "@/lib/posts"
import { links } from "@/lib/site"
import { useTranslations } from "@/i18n"
import type { TagKey } from "@/lib/tags"

/**
 * A single post.
 *
 * The disclaimer at the foot is rendered here, not written per post. Writing
 * about mood disorders for people who have one can read as clinical guidance
 * whether or not it meant to, and the post most likely to need that line is
 * the one written quickly. Putting it in the layout means it can't be
 * forgotten, and it sits after the writing rather than gating it.
 */

interface Props {
  post: Post
}

const { post } = Astro.props
const { title, description, pubDate, updatedDate, tags, draft } = post.data
const t = useTranslations()
---

<BaseLayout title={`${title} — Humeur`} description={description}>
  <article class="mx-auto w-full max-w-[46rem] px-4 py-12 sm:px-8 sm:py-16">
    <a
      href="/blog/"
      class="mb-8 inline-block font-mono text-[10px] tracking-[0.15em] text-muted-strong uppercase no-underline hover:text-foreground"
    >
      ← {t.blog.backToBlog}
    </a>

    <header class="border-b border-border pb-7">
      {
        draft && (
          <p class="mb-3 inline-block rounded-md border border-danger/45 px-2 py-[3px] font-mono text-[10px] tracking-[0.08em] text-danger uppercase">
            {t.blog.draftBadge}
          </p>
        )
      }
      <h1
        class="font-display text-[clamp(1.875rem,5.2vw,2.75rem)] leading-[1.1] font-medium tracking-[-0.025em] text-balance"
      >
        {title}
      </h1>
      <p class="mt-4 max-w-[38rem] text-[17px] text-muted-strong">{description}</p>

      <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-2">
        <p class="font-mono text-[11px] tracking-[0.06em] text-muted-strong">
          <time datetime={isoDate(pubDate)}>{formatPostDate(pubDate)}</time>
          {
            updatedDate && (
              <>
                {" · "}
                {t.blog.updated}{" "}
                <time datetime={isoDate(updatedDate)}>{formatPostDate(updatedDate)}</time>
              </>
            )
          }
        </p>
        <TagList tags={tags as readonly TagKey[]} />
      </div>
    </header>

    <div class="prose mt-9">
      <slot />
    </div>

    <aside
      class="mt-14 rounded-[10px] border border-border-strong bg-surface p-5 sm:p-7"
      aria-labelledby="post-disclaimer"
    >
      <h2
        id="post-disclaimer"
        class="font-mono text-[10px] tracking-[0.13em] text-muted-strong uppercase"
      >
        {t.blog.disclaimerHeading}
      </h2>
      <p class="mt-3 max-w-[42rem] text-sm leading-[1.65] text-muted-strong">
        {t.blog.disclaimer}
      </p>
      <Button href={links.crisis} variant="ghost" size="sm" class="mt-4">
        {t.blog.crisisCta}
      </Button>
    </aside>
  </article>
</BaseLayout>
